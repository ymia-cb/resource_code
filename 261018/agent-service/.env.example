# 数据库配置（默认本机 Docker MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ecommerce_agent

# checkpoint 后端：mysql（默认）/ sqlite
CHECKPOINT_BACKEND=mysql

# 小模型（意图分类 / RAG 生成 / reflector）
# 未配置 API_KEY + MODEL 时自动降级 mock（离线可跑）
SMALL_LLM_BASE_URL=https://api.openai.com/v1
SMALL_LLM_API_KEY=
SMALL_LLM_MODEL=
SMALL_LLM_TIMEOUT=30
SMALL_LLM_MAX_RETRIES=2

# 大模型（planner / summarize）
LARGE_LLM_BASE_URL=https://api.openai.com/v1
LARGE_LLM_API_KEY=
LARGE_LLM_MODEL=
LARGE_LLM_TIMEOUT=30
LARGE_LLM_MAX_RETRIES=2

# 视觉模型（image_understand，如 Qwen-VL / Gemini）
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_TIMEOUT=30
VLM_MAX_RETRIES=2

# MCP 端点鉴权（留空则不鉴权，仅本地开发用）
MCP_API_TOKEN=
